# Written by install.sh. Keep this file private.
EVERLOOM_DOMAIN=example.com
# Leave empty for a real domain. "tls internal" = self-signed (IP-only mode).
EVERLOOM_TLS=
# 64 hex chars. Encrypts stored API keys. Do not lose it: keys can't be decrypted without it.
EVERLOOM_SECRET_KEY=
EVERLOOM_SECURE_COOKIES=1
EVERLOOM_TRUST_PROXY=1
# Optional: path to an existing SillyTavern install to import from (mounted read-only at /import/sillytavern).
SILLYTAVERN_DIR=
LOG_LEVEL=warn
